# Copy to .env and fill in. Never commit .env — it is gitignored.
# Values marked (public) are safe to expose to the browser. Everything else is server-only.

# ---------------------------------------------------------------------------
# Supabase — auth, storage, Postgres
# Dashboard: https://supabase.com/dashboard/project/<SUPABASE_PROJECT_ID>
# ---------------------------------------------------------------------------

# Project ref, e.g. abcdefghijklmnopqrst
SUPABASE_PROJECT_ID=

# Personal access token for the CLI, from
# https://supabase.com/dashboard/account/tokens
#
# Optional — without it the CLI uses whatever `npm run db:login` last stored. Set it if
# you are signed in to more than one Supabase account on this machine: `supabase login`
# keeps a single token, so the wrong account wins silently and the CLI then reports a
# privileges error rather than a wrong-account one. This pins the repo to the account
# that owns SUPABASE_PROJECT_ID.
SUPABASE_ACCESS_TOKEN=

# (public) https://<SUPABASE_PROJECT_ID>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# (public) Settings → API → anon / publishable key. Safe in the browser; RLS is what protects data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Settings → API → service_role key. Bypasses RLS. Server-only — never expose to the browser.
# Not used by the task-001 scaffold; required by later tasks (storage, admin operations).
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Web — apps/web
# ---------------------------------------------------------------------------

# (public) Base URL of the versioned public API consumed by web and, later, mobile.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# (public) Cloudflare Turnstile site key. Also enable CAPTCHA in Supabase Auth with
# the matching secret before launch; the public key alone cannot enforce it.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# (public) Product gates. The web reads them at build time, so rebuild after changing
# one. The API reads the same values at runtime and returns 404 for disabled features.
# Existing behaviour is preserved when a value is absent: all shipped features are on
# except the sourced question browser, which stays private by default.
NEXT_PUBLIC_FEATURE_MOCK_INTERVIEWS=true
NEXT_PUBLIC_FEATURE_COURSES=true
NEXT_PUBLIC_FEATURE_ARENA=true
NEXT_PUBLIC_FEATURE_REPORTS=true
NEXT_PUBLIC_FEATURE_QUESTIONS=false

# (public) Individual course gates. A disabled course disappears from Courses and Arena,
# and its direct course, chapter, Arena, and challenge URLs return 404.
NEXT_PUBLIC_COURSE_JAVA_ENABLED=true
NEXT_PUBLIC_COURSE_DSA_ENABLED=true
NEXT_PUBLIC_COURSE_AI_AGENTS_ENABLED=true
NEXT_PUBLIC_COURSE_SYSTEM_DESIGN_ENABLED=true

# Deprecated alias for NEXT_PUBLIC_FEATURE_QUESTIONS. Kept so existing deployments do
# not accidentally expose or hide the bank during rollout.
NEXT_PUBLIC_QUESTION_BANK_BROWSABLE=false

# (public) Shown on /privacy, /terms and /contact. Until set, these details show a
# visible "[to be confirmed before launch]" marker instead of an invented value.
#   operator name   : the person or company responsible for the data (DPDP "Data Fiduciary")
#   grievance officer: the named person who handles privacy complaints (DPDP requirement)
NEXT_PUBLIC_LEGAL_OPERATOR_NAME=
NEXT_PUBLIC_GRIEVANCE_OFFICER_NAME=

# ---------------------------------------------------------------------------
# API — apps/api
# ---------------------------------------------------------------------------

# Same value as NEXT_PUBLIC_SUPABASE_URL. Used to derive the JWT issuer and JWKS URL,
# so the backend can verify Supabase-issued tokens without any shared secret.
SUPABASE_URL=

# JDBC URL for the database the API reads and writes. The schema itself is owned by
# the Supabase CLI (supabase/migrations) — the API never runs migrations.
#   hosted Supabase : jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
#   local stack     : jdbc:postgresql://localhost:54322/postgres
#
# Use the pooler host, not db.<ref>.supabase.co — the direct host is IPv6-only and most
# home and office networks cannot reach it.
#
# Use port 5432 (session mode), NOT 6543 (transaction mode). Transaction mode hands a
# different backend to each statement, which breaks the server-side prepared statements
# the JDBC driver relies on. If you ever must use 6543, add `prepareThreshold=0`.
DATABASE_URL=

# hosted Supabase : postgres.<SUPABASE_PROJECT_ID>   local stack: postgres
DATABASE_USER=

# hosted Supabase : the database password (Settings → Database)
# local stack     : postgres
DATABASE_PASSWORD=

# ---------------------------------------------------------------------------
# Interview engine — Google Gemini
#
# One key covers the whole voice loop: the interviewer's speech, understanding the
# candidate's spoken answer, and scoring. No separate STT, TTS or voice vendor.
# Get one at https://aistudio.google.com/apikey (keys start with "AIza").
#
# Configured defaults in apps/api/src/main/resources/application.yml:
#   gemini-3.1-flash-lite          primary reasoning and audio understanding
#   gemini-3.5-flash               fallback reasoning and audio understanding
#   gemini-2.5-flash-preview-tts   interviewer voice, returns 24 kHz PCM
# Deployment values may override the reasoning models below.
# ---------------------------------------------------------------------------

GEMINI_API_KEY=
# Zero disables the in-app guard until a daily budget is chosen (1 USD = 1000000).
AI_DAILY_SPEND_CAP_MICRO_USD=0
AI_PER_USER_DAILY_CAP_MICRO_USD=2000000

# ---------------------------------------------------------------------------
# Notifications — reminders for scheduled interviews
#
# Both are optional. With neither set, the dispatcher logs and marks reminders
# `skipped_no_transport`, which is a supported state rather than a failure.
#
# Email needs a provider account and a verified sending domain. WhatsApp needs a
# WhatsApp Business account, business verification, and per-template approval from
# Meta — allow days for that, not hours.
# ---------------------------------------------------------------------------

RESEND_API_KEY=
NOTIFICATIONS_FROM_EMAIL=

# Lifecycle emails: Amazon SES SMTP. Leave EMAIL_ENABLED=false until domain, SMTP
# credentials, production access, content endpoint and schema migration are ready.
EMAIL_ENABLED=false
EMAIL_FROM=
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
EMAIL_PUBLIC_BASE_URL=http://localhost:3000
EMAIL_API_BASE_URL=http://localhost:8080
EMAIL_DAILY_QUESTION_URL=http://localhost:3000/api/internal/daily-question
EMAIL_CONTENT_TOKEN=

WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# ---------------------------------------------------------------------------
# Supabase CLI — local stack only (`npm run db:start`), needs Docker
#
# The hosted project's Google provider is configured in the dashboard, not here.
# These two configure the same provider for the local stack; the same Google OAuth
# client works if you add http://localhost:54321/auth/v1/callback to its redirect URIs.
# ---------------------------------------------------------------------------

SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
ADMIN_EMAILS=
ADMIN_USER_IDS=
FALLBACK_PROVIDER_API_KEY=
FALLBACK_PROVIDER_BASE_URL=
FALLBACK_PROVIDER_MODEL=
GEMINI_PRIMARY_MODEL=

# ---------------------------------------------------------------------------
# Error reporting — Sentry (optional; with no DSN nothing is sent)
#
# Create two projects at https://sentry.io (a Next.js one and a Java/Spring one) and copy
# each one's DSN. No session replay, no request bodies, no default PII is sent by either.
# ---------------------------------------------------------------------------

# API (apps/api)
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# (public) Web (apps/web) — read at build time
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1

# Build only, to upload web source maps so stack traces are readable. Leave empty locally.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
