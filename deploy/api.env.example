# Copy to deploy/api.env on the VM, fill in every required value, and chmod 600.
# Never commit the filled file. For all available settings, see ../.env.example.

DATABASE_URL=
DATABASE_USER=
DATABASE_PASSWORD=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
WEB_ALLOWED_ORIGINS=https://untiered.tech

# Choose an initial limit with the owner. Zero disables the optional-call guard.
AI_DAILY_SPEND_CAP_MICRO_USD=
AI_PER_USER_DAILY_CAP_MICRO_USD=2000000

NEXT_PUBLIC_FEATURE_MOCK_INTERVIEWS=true
NEXT_PUBLIC_FEATURE_COURSES=true
NEXT_PUBLIC_FEATURE_ARENA=true
NEXT_PUBLIC_FEATURE_REPORTS=true
NEXT_PUBLIC_FEATURE_QUESTIONS=false

SENTRY_ENVIRONMENT=production
