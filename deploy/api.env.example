# Copy to deploy/api.env on the VM, fill in every required value, and chmod 600.
# Never commit the filled file. For all available settings, see ../.env.example.

DATABASE_URL=
DATABASE_USER=
DATABASE_PASSWORD=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
GEMINI_API_KEY=
WEB_ALLOWED_ORIGINS=https://untiered.tech

# Owner-approved cap: $10/day (10,000,000 micro-USD) for optional AI
# preparation calls; the provider's billing controls remain the hard spend limit.
AI_DAILY_SPEND_CAP_MICRO_USD=10000000
AI_DAILY_SPEND_CAP_REQUIRED=true
AI_PER_USER_DAILY_CAP_MICRO_USD=5000000

NEXT_PUBLIC_FEATURE_MOCK_INTERVIEWS=true
NEXT_PUBLIC_FEATURE_COURSES=true
NEXT_PUBLIC_FEATURE_ARENA=true
NEXT_PUBLIC_FEATURE_REPORTS=true
NEXT_PUBLIC_FEATURE_QUESTIONS=false

SENTRY_ENVIRONMENT=production
# SENTRY_RELEASE is set from RELEASE_TAG in compose.yaml. Do not set it here.

# Lifecycle mail uses SES v2. Credentials stay on the API host only.
EMAIL_ENABLED=false
AWS_REGION=ap-southeast-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SES_FROM_EMAIL=noreply@untiered.tech
SES_REPLY_TO_EMAIL=help@untiered.tech
EMAIL_PUBLIC_BASE_URL=https://untiered.tech
EMAIL_API_BASE_URL=https://api.untiered.tech
EMAIL_DAILY_QUESTION_URL=https://untiered.tech/api/internal/daily-question
EMAIL_CONTENT_TOKEN=

# Paid interviews (Razorpay). Leave the key pair empty to keep buying switched off.
# Live keys only after the owner has completed Razorpay KYC and approved pricing.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Java code runner (self-hosted Piston). Leave off until a runner exists. Piston runs
# --privileged, so put it on its own host, never this one, and allow only this host to
# reach its port. See the Java code runner section of the root .env.example.
CODE_RUNNER_ENABLED=false
# CODE_RUNNER_BASE_URL=http://<runner-private-ip>:2000/api/v2
